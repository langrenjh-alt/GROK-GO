GROK_GO_ENV=production
# Set explicitly when a stable instance identity is available.
GROK_GO_INSTANCE_ID=
GROK_GO_LISTEN_ADDR=:8080
GROK_GO_PUBLIC_URL=https://grok.example.com
# Enable only when an ingress proxy overwrites forwarding headers.
GROK_GO_TRUST_PROXY_HEADERS=false
GROK_GO_HTTP_READ_TIMEOUT=30s
GROK_GO_HTTP_WRITE_TIMEOUT=2m
GROK_GO_HTTP_IDLE_TIMEOUT=2m
GROK_GO_DATABASE_URL=postgres://grok_go:change-me@127.0.0.1:5432/grok_go?sslmode=disable
GROK_GO_DB_MAX_CONNS=20
GROK_GO_DB_MIN_CONNS=2
GROK_GO_DB_CONN_LIFETIME=30m
GROK_GO_DB_CONN_IDLE_TIME=5m
GROK_GO_DB_HEALTH_TIMEOUT=5s
GROK_GO_REDIS_URL=redis://127.0.0.1:6379/0
GROK_GO_REDIS_PREFIX=grok-go:
GROK_GO_REDIS_DIAL_TIMEOUT=5s
GROK_GO_REDIS_READ_TIMEOUT=3s
GROK_GO_REDIS_WRITE_TIMEOUT=3s
GROK_GO_REDIS_HEALTH_TIMEOUT=3s
# Generate with: openssl rand -base64 32
GROK_GO_MASTER_KEY=
# Optional separate 32-byte key; defaults to GROK_GO_MASTER_KEY.
GROK_GO_TOKEN_PEPPER=
# Required only until the first administrator is created.
GROK_GO_BOOTSTRAP_TOKEN=
# Optional non-interactive first administrator; set both or neither.
GROK_GO_ADMIN_EMAIL=
GROK_GO_ADMIN_PASSWORD=
GROK_GO_SESSION_TTL=24h
GROK_GO_SESSION_COOKIE=grok_go_admin
GROK_GO_COOKIE_SECURE=true
GROK_GO_COOKIE_DOMAIN=
GROK_GO_CSRF_HEADER=X-CSRF-Token
GROK_GO_TRUSTED_ORIGIN=https://grok.example.com
GROK_GO_TOTP_ISSUER=GROK-GO
GROK_GO_XAI_OAUTH_AUTHORIZE_URL=https://auth.x.ai/oauth2/authorize
GROK_GO_XAI_OAUTH_TOKEN_URL=https://auth.x.ai/oauth2/token
GROK_GO_XAI_OAUTH_CLIENT_ID=b1a00492-073a-47ea-816f-4c329264a828
GROK_GO_XAI_OAUTH_SCOPE=openid profile email offline_access grok-cli:access api:access
GROK_GO_XAI_OAUTH_REDIRECT_URL=http://127.0.0.1:56121/callback
GROK_GO_DATA_DIR=./data
GROK_GO_LOG_LEVEL=info
GROK_GO_REQUEST_LOG_RETENTION_DAYS=30
GROK_GO_MEDIA_MAX_BYTES=21474836480
GROK_GO_MEDIA_MAX_FETCH_BYTES=26214400
GROK_GO_IMAGE_TTL=72h
GROK_GO_VIDEO_TTL=168h
GROK_GO_MEDIA_SIGNED_URL_TTL=1h
